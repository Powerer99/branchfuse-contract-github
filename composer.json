{
    "name": "powerer99/branchfuse-contract",
    "description": "Small PHP project with a mix of passing and failing tests, for trying out BranchFuse.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": { "App\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "App\\Tests\\": "tests/" }
    },
    "config": {
        "platform": { "php": "8.3.0" },
        "sort-packages": true
    }
}
